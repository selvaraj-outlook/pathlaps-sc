# Terraform providers and plugins - never commit these (can be 100s of MBs)
.terraform/
.terraform.tfstate
.terraform.tfstate.backup

# Terraform state files - contain secrets, managed remotely
terraform.tfstate
terraform.tfstate.backup
terraform.tfstate.d/

# Terraform plan files - binary, environment-specific
*.tfplan
file.txt

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform crash log
crash.log
crash.*.log

# Lambda build artifacts
modules/service-catalog/lambda/.build/

# macOS
.DS_Store
